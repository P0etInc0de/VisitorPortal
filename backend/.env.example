APP_NAME=VisitorPortal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Berlin

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_DECAY_SECONDS=60
AUTH_PASSWORD_RESET_MAX_ATTEMPTS=6
AUTH_PASSWORD_RESET_DECAY_SECONDS=60

# Authentication mode:
# local = local login only
# local_and_sso = local login and SSO login
# sso_only = SSO for normal users, local login only for break-glass accounts
AUTH_MODE=local

SSO_ENABLED=false
SSO_DRIVER=oidc

OIDC_DISPLAY_NAME="Company SSO"
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI="${APP_URL}/auth/oidc/callback"
OIDC_SCOPES="openid profile email"
OIDC_REQUIRE_VERIFIED_EMAIL=true
OIDC_ALLOWED_DOMAINS=
OIDC_PROVISIONING_MODE=disabled
OIDC_SYNC_USER_PROFILE=true
OIDC_STORE_CLAIMS=false
OIDC_SYNC_ROLES=false
OIDC_SYNC_ROLES_ON_LOGIN=false
OIDC_SYNC_ROLES_REMOVE_UNMAPPED=false
OIDC_GROUPS_CLAIM=groups
OIDC_LOGOUT_MODE=local
OIDC_CLOCK_TOLERANCE=60
OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
OIDC_AUTO_PROVISION_DEFAULT_ROLE=user
OIDC_AUTO_PROVISION_DEFAULT_DEPARTMENT_ID=

MFA_ENABLED=true
MFA_OPTIONAL_FOR_USERS=true
APP_MFA_REQUIRED_ROLES=admin,super_admin
APP_MFA_REQUIRED_FOR_AUTH_METHODS=local
# Requires an App-MFA-confirmed session for /admin; it does not prompt again if App-MFA was already confirmed in this session.
# For SSO admins, this triggers a local VisitorPortal App-MFA challenge only when the current SSO session has not passed App-MFA yet.
APP_MFA_REQUIRED_FOR_ADMIN_PANEL_AUTH_METHODS=local,sso
APP_MFA_SESSION_TTL_MINUTES=720

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=visitorportal
DB_USERNAME=visitor
DB_PASSWORD=visitor_pw

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180

CACHE_STORE=database
# CACHE_PREFIX=

HEALTH_CACHE_STORE=database
HEALTH_QUEUE_STALE_AFTER=300
HEALTH_SCHEDULER_STALE_AFTER=300
HEALTH_HEARTBEAT_TTL=600

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=visitorportal@example.test
MAIL_FROM_NAME="VisitorPortal"

# Visitor contact fields are optional by default. Supported values: optional, require_one, require_email, require_phone.
VISITOR_CONTACT_REQUIREMENT=optional

# Reception operation windows.
# Hours ahead from now for the Check-In/Out board. Planned visits starting within this window and not yet ended can be checked in.
RECEPTION_CHECK_IN_WINDOW_HOURS=48
# Hours ahead from now for the reception dashboard badge-preparation count. Counts unprinted badges for planned visits in this window.
RECEPTION_BADGE_PREPARATION_WINDOW_HOURS=48

# Privacy retention defaults.
PRIVACY_VISIT_RETENTION_DAYS=365
PRIVACY_PURGE_ENABLED=true
PRIVACY_PURGE_CHUNK_SIZE=500
PRIVACY_NOTIFICATION_RETENTION_DAYS=365
PRIVACY_SEARCH_RATE_LIMIT_PER_MINUTE=60
PRIVACY_WALK_IN_CONFIDENTIAL_DEFAULT=true
# Optional operator-owned privacy notice URL. External guest mails include this link when set.
PRIVACY_NOTICE_URL=
DATA_RETENTION_RUN_LOG_DAYS=1095
PRIVACY_TECHNICAL_RETENTION_ENABLED=true
PRIVACY_SESSION_RETENTION_DAYS=30
PRIVACY_FAILED_JOB_RETENTION_DAYS=30
PRIVACY_JOB_BATCH_RETENTION_DAYS=30
PRIVACY_LOG_RETENTION_DAYS=30
PRIVACY_HEALTH_CACHE_RETENTION_DAYS=7

# White-label branding. Override these paths with files inside backend/public.
BRANDING_NAME="VisitorPortal"
BRANDING_LOGO_LIGHT="images/branding/logo-with-text-light.svg"
BRANDING_LOGO_DARK="images/branding/logo-with-text-dark.svg"
BRANDING_MAIL_LOGO="images/branding/logo-with-text-light.svg"
BRANDING_BADGE_LOGO="images/branding/logo-with-text-light.svg"
BRANDING_BADGE_DESIGN="standard"
BRANDING_BADGE_ACCENT_COLOR="#ff8a00"
BRANDING_MONITOR_FALLBACK_HEADING="Welcome to VisitorPortal"
BRANDING_MONITOR_FALLBACK_SUBHEADING="We're glad you're here."
BRANDING_MONITOR_SLIDE_HEADING="Welcome!"
# Disabled by default for privacy. Enable only if visitor monitor slides are intentionally used.
BRANDING_MONITOR_AUTO_GENERATION=false
BRANDING_MONITOR_DISPLAY_MODE=title_first_initial_last_name

VISITORPORTAL_EASTER_EGG=false
VISITORPORTAL_EASTER_EGG_PRODUCTION=false

# Branding and monitor image upload guardrails. 20 MB remains intentionally allowed for large displays.
UPLOAD_IMAGE_MAX_SIZE_KB=20480
UPLOAD_IMAGE_MAX_WIDTH=20000
UPLOAD_IMAGE_MAX_HEIGHT=20000
UPLOAD_IMAGE_MAX_PIXELS=150000000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# For PDF Badge (Gotenberg in Docker):
GOTENBERG_URL=http://gotenberg:3000

#GitHub Link
GITHUB_REPO_URL="https://github.com/P0etInc0de/VisitorPortal"
