{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "types": ["node", "@playwright/test", "vite/client"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true
    },
    "include": [
        "playwright.config.ts",
        "resources/js/**/*.ts",
        "tests/e2e/**/*.ts"
    ]
}
