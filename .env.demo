# Release packages should pin this to a version tag, for example: v1.0.2
BESUCHERPORTAL_VERSION=latest

# Advanced override. Usually not needed.
# BESUCHERPORTAL_IMAGE=ghcr.io/p0etinc0de/besucherportal:v1.0.2

# Optional host port overrides if 8080 or 8025 are already in use.
# APP_PORT=8080
# MAILHOG_PORT=8025
